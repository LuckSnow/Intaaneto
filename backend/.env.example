# Intaaneto backend development environment
# Copy this file to backend/.env. Never commit backend/.env or real secrets.

# Django
# Development can start with this placeholder. Generate a unique value before
# sharing/deploying the application.
SECRET_KEY=change-me-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# PostgreSQL
# These values are for running Django directly on the host.
# Docker Compose overrides them with its internal `db` connection settings.
DB_NAME=intaaneto_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Browser/API origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# AI Tutor response provider
# The web can start with an empty key, but live AI requests require a valid key.
OPENAI_API_KEY=
AI_GENERATION_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=12

# Local ONNX RAG embedding/indexing. The model is downloaded on first use unless
# it is already present in the FastEmbed/Hugging Face cache.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_REVISION=fastembed-0.8.0-mean-pooling
RAG_EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_CHUNKS_PER_SOURCE=500

# Optional multimedia prototype providers
# Groq creates a lesson script; D-ID creates a presenter video.
GROQ_API_KEY=
DID_API_KEY=

# Firebase Google login
# Must match VITE_FIREBASE_PROJECT_ID in frontend/.env when Google login is used.
FIREBASE_PROJECT_ID=

# Optional Django Allauth Google OAuth configuration
# The current frontend login flow uses Firebase, so these may remain empty.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Upload paths
MEDIA_ROOT=media
MEDIA_URL=/media/

# Development email: prints messages in the backend console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Optional Mailjet configuration. Change EMAIL_BACKEND to
# anymail.backends.mailjet.EmailBackend only when both keys are configured.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
