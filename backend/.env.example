# Intaaneto backend development environment
# Copy this file to backend/.env. Never commit backend/.env or real secrets.

# Django
# Development can start with this placeholder. Generate a unique value before
# sharing/deploying the application.
SECRET_KEY=change-me-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# PostgreSQL
# These values are for running Django directly on the host.
# Docker Compose overrides them with its internal `db` connection settings.
DB_NAME=intaaneto_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Browser/API origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_X_FORWARDED_PROTO=False

# JWT lifetimes (minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Optional local-only credentials used by `python manage.py seed_demo_data`.
# Leave blank to create demo accounts with unusable passwords.
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_PASSWORD=

# AI Tutor response provider
# Choose openai, gemini, or groq. The web can start with empty keys, but grounded
# answers with sufficient evidence require the selected provider's valid key.
AI_GENERATION_PROVIDER=openai
OPENAI_API_KEY=
AI_GENERATION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GROQ_API_KEY=
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=12
AI_AUTHORING_MAX_SOURCE_CHARS=12000
AI_VIDEO_SCRIPT_MAX_TOKENS=2400
AI_ASSESSMENT_FIVE_QUESTION_MAX_CHUNKS=6
AI_ASSESSMENT_TEN_QUESTION_MAX_CHUNKS=15

# Local Vietnamese narration (no API key)
TTS_ESPEAK_EXECUTABLE=espeak-ng
TTS_ESPEAK_VOICE=vi
TTS_ESPEAK_SPEED=155
TTS_TIMEOUT_SECONDS=30
PIPER_PYTHON_EXECUTABLE=python
PIPER_VOICE=vi_VN-vais1000-medium
PIPER_MODEL_PATH=/app/tts-models/vi_VN-vais1000-medium.onnx
PIPER_TIMEOUT_SECONDS=120
PIPER_LENGTH_SCALE=1.12
# Silence appended after a comma/semicolon/colon and after a completed sentence.
PIPER_CLAUSE_PAUSE_MS=160
PIPER_SENTENCE_PAUSE_MS=500
MULTIMEDIA_FFMPEG_EXECUTABLE=ffmpeg
MULTIMEDIA_TUTOR_IMAGE_PATH=/app/media-assets/AI_tutor.png
MULTIMEDIA_TIMEOUT_SECONDS=180
MULTIMEDIA_MAX_DURATION_SECONDS=300
LESSON_DISPLAY_CONTENT_MAX_CHARS=20000

# Local ONNX RAG embedding/indexing. The model is downloaded on first use unless
# it is already present in the FastEmbed/Hugging Face cache.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_REVISION=fastembed-0.8.0-mean-pooling
RAG_EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_CHUNKS_PER_SOURCE=500
# Provisional exact-cosine retrieval baseline; tune from the evaluation set.
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_MAX_TOP_K=10
RAG_RETRIEVAL_MIN_SCORE=0.45
RAG_MAX_QUESTION_CHARS=1000
RAG_GENERATION_MAX_EVIDENCE_CHUNKS=3
RAG_GENERATION_MAX_CONTEXT_CHARS=6000
RAG_CITATION_EXCERPT_CHARS=320
RAG_REINFORCEMENT_MAX_OBJECTIVES=5
RAG_REINFORCEMENT_TOP_K=2

# Optional local SadTalker PoC. No API key is used.
SADTALKER_ENABLED=False
SADTALKER_ROOT=/opt/SadTalker
SADTALKER_PYTHON_EXECUTABLE=/opt/sadtalker-venv/bin/python
SADTALKER_TIMEOUT_SECONDS=900
SADTALKER_MAX_AUDIO_BYTES=26214400
SADTALKER_MAX_AUDIO_SECONDS=600
SADTALKER_MAX_PORTRAIT_BYTES=10485760
SADTALKER_MAX_PORTRAIT_PIXELS=16000000
SADTALKER_MAX_OUTPUT_BYTES=262144000

# Lesson PDF ingestion limits (bytes, pages, extracted characters)
LESSON_PDF_MAX_BYTES=20971520
LESSON_PDF_MAX_PAGES=100
LESSON_PDF_MAX_EXTRACTED_CHARS=250000

# Durable PDF ingestion queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_BROKER_CONNECTION_TIMEOUT=3
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
LESSON_INGESTION_MAX_RETRIES=2
LESSON_INGESTION_RETRY_BASE_SECONDS=10
LESSON_INGESTION_LEASE_SECONDS=1800

# Optional multimedia prototype provider
# D-ID creates a presenter video.
DID_API_KEY=

# Firebase Google login
# Must match VITE_FIREBASE_PROJECT_ID in frontend/.env when Google login is used.
FIREBASE_PROJECT_ID=

# Optional Django Allauth Google OAuth configuration
# The current frontend login flow uses Firebase, so these may remain empty.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Upload paths
MEDIA_ROOT=media
MEDIA_URL=/media/

# Development email: prints messages in the backend console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
DEFAULT_FROM_EMAIL_NAME=Intaaneto
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Application-level abuse controls. Multi-instance production deployments must
# use a shared Django cache and/or enforce additional limits at the gateway.
THROTTLE_AUTH_REGISTER=5/hour
THROTTLE_AUTH_LOGIN=10/minute
THROTTLE_AUTH_VERIFY=20/hour
THROTTLE_AUTH_RESEND=5/hour
THROTTLE_AUTH_PASSWORD_RESET_REQUEST=5/hour
THROTTLE_AUTH_PASSWORD_RESET_CONFIRM=10/hour
THROTTLE_TEACHER_APPLICATION=3/day
THROTTLE_LESSON_UPLOAD=5/hour
THROTTLE_LESSON_REPROCESS=10/hour
THROTTLE_AI_CHAT=30/minute
THROTTLE_AI_HINT=20/minute
THROTTLE_ASSESSMENT_SUBMIT=20/hour
THROTTLE_ASSESSMENT_REINFORCEMENT=20/hour
THROTTLE_ASSESSMENT_DIALOGUE=10/hour
THROTTLE_LESSON_AUTHORING=10/hour
THROTTLE_VIDEO_GENERATION=3/hour

# Optional Mailjet configuration. Change EMAIL_BACKEND to
# anymail.backends.mailjet.EmailBackend only when both keys are configured.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
