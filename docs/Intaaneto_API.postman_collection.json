{
	"info": {
		"_postman_id": "8b9a1c1d-6e54-4a2b-91d8-04f7c2295ae2",
		"name": "Intaaneto E-Learning & RAG AI Tutor API",
		"description": "Comprehensive API collection for testing Intaaneto E-learning system with Supabase PostgreSQL + pgvector RAG, Cloudflare R2, Course Authoring, and Assessments.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "teacherToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "studentToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "sessionId",
			"value": "",
			"type": "string"
		},
		{
			"key": "courseSlug",
			"value": "demo-ai-tutor-rag",
			"type": "string"
		},
		{
			"key": "lessonId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Login as Teacher (Demo)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.tokens && jsonData.tokens.access) {",
									"    pm.collectionVariables.set('teacherToken', jsonData.tokens.access);",
									"    console.log('Teacher token saved');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"demo.teacher@example.invalid\",\n    \"password\": \"Teacher123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login",
								""
							]
						}
					}
				},
				{
					"name": "1.2 Login as Student (Demo)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.tokens && jsonData.tokens.access) {",
									"    pm.collectionVariables.set('studentToken', jsonData.tokens.access);",
									"    console.log('Student token saved');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"demo.student@example.invalid\",\n    \"password\": \"Student123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login",
								""
							]
						}
					}
				},
				{
					"name": "1.3 Get Current User Profile (Teacher)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacherToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/profile/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"profile",
								""
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Courses & Lessons",
			"item": [
				{
					"name": "2.1 List All Courses",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/courses/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								""
							]
						}
					}
				},
				{
					"name": "2.2 Get Course Detail (by Slug)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/courses/{{courseSlug}}/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"{{courseSlug}}",
								""
							]
						}
					}
				},
				{
					"name": "2.3 Get Lesson Detail",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/courses/lessons/{{lessonId}}/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"lessons",
								"{{lessonId}}",
								""
							]
						}
					}
				}
			]
		},
		{
			"name": "3. RAG Knowledge Ingestion (Teacher)",
			"item": [
				{
					"name": "3.1 Upload PDF Document to Lesson",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacherToken}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "uploaded_file",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/courses/lessons/{{lessonId}}/upload-pdf/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"lessons",
								"{{lessonId}}",
								"upload-pdf",
								""
							]
						}
					}
				},
				{
					"name": "3.2 Check Ingestion Status (Polling)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacherToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/courses/lessons/{{lessonId}}/ingestion-status/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"lessons",
								"{{lessonId}}",
								"ingestion-status",
								""
							]
						}
					}
				},
				{
					"name": "3.3 Reprocess Lesson Ingestion",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{teacherToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/courses/lessons/{{lessonId}}/reprocess/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"lessons",
								"{{lessonId}}",
								"reprocess",
								""
							]
						}
					}
				}
			]
		},
		{
			"name": "4. AI Tutor RAG Chat (Learner)",
			"item": [
				{
					"name": "4.1 Create Chat Session",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('sessionId', jsonData.id);",
									"    console.log('Session ID saved:', jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Hỏi đáp về RAG\",\n    \"lesson\": {{lessonId}}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/ai/chat/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"ai",
								"chat",
								""
							]
						}
					}
				},
				{
					"name": "4.2 Send Question (RAG Grounded Retrieval)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"RAG giúp ích gì cho việc học tập và trích xuất nguồn từ đâu?\",\n    \"lesson_id\": {{lessonId}}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/ai/chat/{{sessionId}}/send_message/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"ai",
								"chat",
								"{{sessionId}}",
								"send_message",
								""
							]
						}
					}
				},
				{
					"name": "4.3 Ask Off-Topic Question (Boundary Fallback Check)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"Thủ đô của nước Pháp là gì và cách làm bánh pizza?\",\n    \"lesson_id\": {{lessonId}}\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/ai/chat/{{sessionId}}/send_message/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"ai",
								"chat",
								"{{sessionId}}",
								"send_message",
								""
							]
						}
					}
				},
				{
					"name": "4.4 Get Hint for Exercise",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{studentToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"lesson_id\": {{lessonId}},\n    \"question\": \"Tôi không hiểu câu hỏi về bước nào thuộc giai đoạn lập chỉ mục.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/ai/chat/{{sessionId}}/get_hint/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"ai",
								"chat",
								"{{sessionId}}",
								"get_hint",
								""
							]
						}
					}
				}
			]
		},
